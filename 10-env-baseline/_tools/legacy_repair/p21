def run_tests():
    r = subprocess.run([PY, "-m", "unittest", "discover", "-s", "tests"],
                       cwd=P1, capture_output=True, text=True, timeout=300)
    tail = [l for l in r.stderr.strip().splitlines() if l.strip()][-1]
    cnt = re.search(r"Ran (\d+) tests", r.stderr)
    ok = r.returncode == 0
    return f"{cnt.group(1) if cnt else '?'} tests / {'OK' if ok else 'FAILED'} / {tail.split()[-1] if tail else ''}"


